# Environment variables for this one-time Drive migration.
# Set these in the Northflank dashboard (CombinedService + Postgres addon).
# Do not put secrets in the repo.
#
# Google Cloud setup (your OAuth client — not a shared Cursor or Grok account):
#   1. Create a Google Cloud project
#   2. Enable the Google Drive API
#   3. Create an OAuth 2.0 Web client
#   4. Add Authorized redirect URI:  ${PUBLIC_BASE_URL}/api/google/callback
#   5. Put the client id/secret below
#
# Northflank:
#   - Link the Postgres addon so DATABASE_URL is injected
#   - Set PUBLIC_BASE_URL to the public https origin of this service
#   - Health check path: /api/health
#   - Keep LONG_RUNNING=1 so copies continue after the browser closes

# Postgres (required on Northflank; the live preview uses an embedded store)
DATABASE_URL=

# Google OAuth 2.0 client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact redirect URI registered on the OAuth client
# Example: https://raw-copy.northflank.app/api/google/callback
GOOGLE_REDIRECT_URI=

# Public origin of this service (used to build the redirect URI if GOOGLE_REDIRECT_URI is unset)
PUBLIC_BASE_URL=

# Destination folder in YOUR Drive (created at the root if missing)
DEST_FOLDER_NAME=Raw

# Copy worker — 5 concurrent files.copy() calls, ~600 GB / 24h
COPY_CONCURRENCY=5
COPY_DAILY_BUDGET_GB=600

# Keep the in-process worker loop alive after the browser closes
LONG_RUNNING=1

# Bind address (Dockerfile / Northflank already set these)
HOST=0.0.0.0
PORT=8080
NITRO_HOST=0.0.0.0
NITRO_PORT=8080
